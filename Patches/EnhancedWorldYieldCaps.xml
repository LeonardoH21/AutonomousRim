<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Only lift vanilla caps. Multipliers belong to the saved scenario. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/StatDef[defName="MiningYield"]/maxValue</xpath>
    <value><maxValue>100</maxValue></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/StatDef[defName="PlantHarvestYield"]/maxValue</xpath>
    <value><maxValue>100</maxValue></value>
  </Operation>
</Patch>
