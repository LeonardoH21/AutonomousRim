								<randomSeed>1149975677</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li>
								<name>slaughtering animals</name>
								<def>AnimalSlaughter_Horrible</def>
								<ID>525</ID>
								<randomSeed>1425265241</randomSeed>
