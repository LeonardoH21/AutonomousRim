							</outSignalsCompleted>
							<state>Enabled</state>
							<enableTick>1001</enableTick>
							<playerWealth>350000</playerWealth>
						</li>
						<li Class="QuestPart_PassOutInterval">
							<signalListenMode>NotYetAcceptedOnly</signalListenMode>
							<inSignalEnable>Quest1.PlayerWealthSatisfied</inSignalEnable>
							<outSignals>
								<li>Quest1.SendLetterReminder</li>
							</outSignals>
							<inSignalsDisable />
							<ticksInterval>3600000</ticksInterval>
						</li>
						<li Class="QuestPart_Filter_PlayerWealth">
							<signalListenMode>NotYetAcceptedOnly</signalListenMode>
							<inSignal>Quest1.SendLetterReminder</inSignal>
							<outSignal>Quest1.OuterNodeCompleted</outSignal>
							<minPlayerWealth>350000</minPlayerWealth>
						</li>
						<li Class="QuestPart_Letter">
							<signalListenMode>NotYetAcceptedOnly</signalListenMode>
							<inSignal>Quest1.OuterNodeCompleted2</inSignal>
