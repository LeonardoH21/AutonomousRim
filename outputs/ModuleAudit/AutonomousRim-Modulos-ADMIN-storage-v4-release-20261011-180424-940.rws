						<name>Ritual Cult</name>
						<adjective>Caobrinic</adjective>
						<memberName>Caobrinite</memberName>
						<leaderTitleMale>Divine Chief</leaderTitleMale>
						<leaderTitleFemale>Divine Chief</leaderTitleFemale>
						<description>The people of the cavernous shell-world Boccocarro lived under the ritual supervision of &lt;color=#D09B61FF&gt;Caobrin&lt;/color&gt;. Then the mine hypervisor came. His abyssal marines killed many worshippers of &lt;color=#D09B61FF&gt;Caobrin&lt;/color&gt; with pickaxes. A hero named Black Llobatra tried to assassinate the mine hypervisor. She failed, but &lt;color=#D09B61FF&gt;Caobrin&lt;/color&gt; witnessed Llobatra's struggle, and anointed her as the prophet of the Caobrinites. Llobatra gathered the Caobrinites in a drip-well and taught them of &lt;color=#D09B61FF&gt;Caobrin&lt;/color&gt;'s wisdom.</description>
						<descriptionTemplate>The people of the cavernous shell-world Boccocarro lived under the ritual supervision of %%deity0_name%%. Then the mine hypervisor came. His abyssal marines killed many worshippers of %%deity0_name%% with pickaxes. A hero named Black Llobatra tried to assassinate the mine hypervisor. She failed, but %%deity0_name%% witnessed Llobatra's struggle, and anointed her as the prophet of the %%memberNamePlural%%. Llobatra gathered the %%memberNamePlural%% in a drip-well and taught them of %%deity0_name%%'s wisdom.</descriptionTemplate>
						<culture>Corunan</culture>
						<iconDef>StarsB</iconDef>
						<colorDef>LightOlive</colorDef>
						<primaryFactionColor>RGBA(0.399, 0.863, 0.441, 1.000)</primaryFactionColor>
						<memes>
							<li>Structure_TheistAbstract</li>
							<li>Ritualist</li>
						</memes>
						<precepts>
							<li>
								<name>void study</name>
								<def>VoidStudy_VeryEfficient</def>
								<ID>145</ID>
								<randomSeed>-1648699753</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li>
								<name>research</name>
								<def>Research_Slow</def>
								<ID>146</ID>
								<randomSeed>1714171221</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li Class="Precept_Ritual">
								<name>Ritual Mourning</name>
								<def>Funeral</def>
								<ID>147</ID>
								<randomSeed>1289942666</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<nameMaker>NamerRitualFuneral</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>You can hold a {IDEOLIGION_adjective} funeral for {PAWN_nameDef}.</ritualExpectedDesc>
								<ritualExpectedDescNoAdjective>You can hold a funeral for {PAWN_nameDef}.</ritualExpectedDescNoAdjective>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>FuneralStandard</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_GraveWithTarget">
									<def>GraveWithTargetsCorpse</def>
									<parent>Precept_147</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior Class="RitualBehaviorWorker_Funeral">
									<def>Funeral</def>
								</behavior>
								<triggers>
									<li Class="RitualObligationTrigger_MemberDied">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
									</li>
								</triggers>
								<outcomeEffect Class="RitualOutcomeEffectWorker_FromQuality">
									<def>AttendedFuneral</def>
									<compDatas>
