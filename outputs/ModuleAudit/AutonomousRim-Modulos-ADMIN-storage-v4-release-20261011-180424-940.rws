			<quests>
				<li>
					<name>EndGame_ArchonexusVictory</name>
					<appearanceTick>1000</appearanceTick>
					<acceptanceTick>1000</acceptanceTick>
					<acceptedBy>null</acceptedBy>
					<initiallyAccepted>True</initiallyAccepted>
